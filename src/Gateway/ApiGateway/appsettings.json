{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "ReverseProxy": {
    "Routes": {
      "posts-route": {
        "ClusterId": "blog-service",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "identity-service",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-service",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "blog-service": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7259"
          }
        }
      },
      "identity-service": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001"
          }
        }
      }
    }
  }
}
