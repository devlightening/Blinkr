<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  
  <!-- Primary Colors -->
  <Color x:Key="Primary">#FF6B47</Color>
  <Color x:Key="OnPrimary">#FFFFFF</Color>
  <Color x:Key="PrimaryLight">#FF8A6B</Color>
  <Color x:Key="PrimaryDark">#E55A36</Color>
  
  <!-- Secondary Colors -->
  <Color x:Key="Secondary">#F1F3F5</Color>
  <Color x:Key="OnSecondary">#2A2E34</Color>
  
  <!-- Background Colors -->
  <Color x:Key="Background">#F5F5F7</Color>
  <Color x:Key="Surface">#FFFFFF</Color>
  <Color x:Key="OnSurface">#2A2E34</Color>
  <Color x:Key="CardBackground">#FFFFFF</Color>
  
  <!-- Text Colors -->
  <Color x:Key="TextPrimary">#000000</Color>
  <Color x:Key="TextSecondary">#666666</Color>
  <Color x:Key="TextTertiary">#999999</Color>
  <Color x:Key="SecondaryDarkText">#2A2E34</Color>
  <Color x:Key="SecondaryLightText">#8E9199</Color>
  
  <!-- Border & Divider -->
  <Color x:Key="Border">#E0E0E0</Color>
  <Color x:Key="Divider">#F0F0F0</Color>
  
  <!-- Accent Colors -->
  <Color x:Key="SuccessMint">#8BE3D1</Color>
  <Color x:Key="LikeRed">#FF6B6B</Color>
  <Color x:Key="CommentBlue">#4A90E2</Color>
  <Color x:Key="LocationPin">#FF6B47</Color>
  
  <!-- Tab Bar -->
  <Color x:Key="TabActive">#FF6B47</Color>
  <Color x:Key="TabInactive">#999999</Color>
  
  <!-- Chip Background -->
  <Color x:Key="ChipBackground">#F0F0F0</Color>
  
  <!-- Shadow -->
  <SolidColorBrush x:Key="CardShadowBrush" Color="#10000000"/>
  
  <!-- Brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
  <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}" />
  
</ResourceDictionary>