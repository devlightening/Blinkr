<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Colors -->
    <Color x:Key="Primary">#FFEA00</Color>
    <Color x:Key="PrimaryDark">#D4C400</Color>
    <Color x:Key="PrimaryLight">#FFF44F</Color>
    
    <!-- Background Colors -->
    <Color x:Key="BackgroundPrimary">#05070B</Color>
    <Color x:Key="BackgroundSecondary">#0F1419</Color>
    <Color x:Key="BackgroundTertiary">#1A1F27</Color>
    <Color x:Key="CardBackground">#16191F</Color>
    <Color x:Key="CardBackgroundHover">#1D2229</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9CA3AF</Color>
    <Color x:Key="TextTertiary">#6B7280</Color>
    <Color x:Key="TextDisabled">#4B5563</Color>
    <Color x:Key="TextInverse">#000000</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentYellow">#FFEA00</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>
    <Color x:Key="AccentGreen">#10B981</Color>
    <Color x:Key="AccentRed">#EF4444</Color>
    <Color x:Key="AccentCyan">#06B6D4</Color>
    
    <!-- Map Pin Colors -->
    <Color x:Key="MapPinMale">#3B82F6</Color>
    <Color x:Key="MapPinFemale">#FFEA00</Color>
    <Color x:Key="MapPinOther">#9CA3AF</Color>
    <Color x:Key="MapPinDefault">#FFEA00</Color>
    
    <!-- Border & Divider Colors -->
    <Color x:Key="BorderColor">#1F2937</Color>
    <Color x:Key="DividerColor">#374151</Color>
    
    <!-- Icon Colors -->
    <Color x:Key="IconPrimary">#FFFFFF</Color>
    <Color x:Key="IconSecondary">#9CA3AF</Color>
    <Color x:Key="IconAccent">#FFEA00</Color>
    
    <!-- Status Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>
    
    <!-- Shadow & Overlay -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="OverlayColor">#80000000</Color>
    
    <!-- Navigation Bar -->
    <Color x:Key="NavBarBackground">#0F1419</Color>
    <Color x:Key="NavBarItemActive">#FFEA00</Color>
    <Color x:Key="NavBarItemInactive">#6B7280</Color>

    <!-- Neon Theme Colors -->
    <Color x:Key="NeonYellow">#FFD42A</Color>
    <Color x:Key="NeonYellowGlow">#80FFD42A</Color>
    <Color x:Key="CardDark">#1C1E26</Color>
    <Color x:Key="AppBackgroundDark">#0F1115</Color>

    <!-- Material Design 3 Aliases -->
    <Color x:Key="Background">#05070B</Color>
    <Color x:Key="OnBackground">#FFFFFF</Color>
    <Color x:Key="OnSurface">#FFFFFF</Color>
    <Color x:Key="OnSurfaceVariant">#9CA3AF</Color>
    <Color x:Key="OnPrimary">#000000</Color>

    <!-- Legacy Aliases for Compatibility -->
    <Color x:Key="BlinkrBackground">#05070B</Color>
    <Color x:Key="BlinkrBackgroundElevated">#0F1419</Color>
    <Color x:Key="BlinkrCardBackground">#16191F</Color>
    <Color x:Key="BlinkrCardBackgroundSoft">#1D2229</Color>
    <Color x:Key="BlinkrAccent">#FFEA00</Color>
    <Color x:Key="BlinkrAccentSoft">#FFF44F</Color>
    <Color x:Key="LikeColor">#EF4444</Color>
    <Color x:Key="CommentColor">#3B82F6</Color>
    <Color x:Key="NotificationUnreadDot">#FFEA00</Color>
    <Color x:Key="Accent">#FFEA00</Color>
    <Color x:Key="AccentGlow">#FFF44F</Color>
    <Color x:Key="Surface">#0F1419</Color>
    <Color x:Key="Secondary">#16191F</Color>
    <Color x:Key="TabInactive">#6B7280</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="BgNavy">#05070B</Color>
    <Color x:Key="ChipBackground">#1D2229</Color>
    <Color x:Key="SuccessMint">#10B981</Color>
    <Color x:Key="SurfaceColor">#16191F</Color>

</ResourceDictionary>