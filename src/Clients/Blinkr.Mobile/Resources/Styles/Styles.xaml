<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Page Style (Dark Background) -->
  <Style TargetType="ContentPage">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="{StaticResource BgNavy}" />
    </Style.Setters>
  </Style>
  
  <!-- ScrollView Style -->
  <Style TargetType="ScrollView">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="Transparent" />
    </Style.Setters>
  </Style>

  <!-- Shell / TabBar -->
  <Style TargetType="Shell">
    <Style.Setters>
      <Setter Property="NavBarHasShadow" Value="False" />
      <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
      <Setter Property="ForegroundColor" Value="{StaticResource TextPrimary}" />
      <Setter Property="TitleColor" Value="{StaticResource TextPrimary}" />
      <Setter Property="TabBarBackgroundColor" Value="{StaticResource Surface}" />
      <Setter Property="TabBarForegroundColor" Value="{StaticResource TabActive}" />
      <Setter Property="TabBarTitleColor" Value="{StaticResource TabActive}" />
      <Setter Property="TabBarUnselectedColor" Value="{StaticResource TabInactive}" />
    </Style.Setters>
  </Style>

  <!-- Tab Bar Item Style -->
  <Style TargetType="TabBar">
    <Style.Setters>
      <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
    </Style.Setters>
  </Style>

  <Style TargetType="Tab">
    <Style.Setters>
      <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
      <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TabInactive}" />
      <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
    </Style.Setters>
  </Style>

  <!-- Typography -->
  <Style TargetType="Label" x:Key="PageTitle">
    <Style.Setters>
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
      <Setter Property="HorizontalOptions" Value="Center" />
      <Setter Property="Margin" Value="0,16,0,16" />
    </Style.Setters>
  </Style>

  <Style TargetType="Label" x:Key="CardTitle">
    <Style.Setters>
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style.Setters>
  </Style>

  <Style TargetType="Label" x:Key="Subtitle">
    <Style.Setters>
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style.Setters>
  </Style>

  <Style TargetType="Label" x:Key="Body">
    <Style.Setters>
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style.Setters>
  </Style>

  <Style TargetType="Label" x:Key="Caption">
    <Style.Setters>
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style.Setters>
  </Style>

  <!-- Entry & Editor -->
  <Style TargetType="Entry">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
      <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
      <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
    </Style.Setters>
  </Style>

  <Style TargetType="Editor">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
      <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
      <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
    </Style.Setters>
  </Style>

  <!-- Primary Button (Snapchat Yellow) -->
  <Style TargetType="Button" x:Key="PrimaryButton">
    <Style.Setters>
      <Setter Property="TextColor" Value="Black" />
      <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HeightRequest" Value="50" />
      <Setter Property="Margin" Value="16,8" />
    </Style.Setters>
  </Style>

  <!-- Secondary Button (Outlined) -->
  <Style TargetType="Button" x:Key="SecondaryButton">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
      <Setter Property="BorderColor" Value="{StaticResource Border}" />
      <Setter Property="BorderWidth" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HeightRequest" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
    </Style.Setters>
  </Style>

  <!-- Tab Button (Filter) -->
  <Style TargetType="Button" x:Key="TabButton">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="16,0" />
    </Style.Setters>
  </Style>

  <Style TargetType="Button" x:Key="TabButtonActive">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="{StaticResource ChipBackground}" />
      <Setter Property="TextColor" Value="{StaticResource Primary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="16,0" />
    </Style.Setters>
  </Style>

  <!-- Card Style (Glassmorphism) -->
  <Style TargetType="Border" x:Key="Card">
    <Style.Setters>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Stroke" Value="{StaticResource CardStrokeBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeShape">
        <Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value>
      </Setter>
      <Setter Property="Shadow">
        <Setter.Value>
          <Shadow Brush="{StaticResource Shadow}" Offset="0,4" Radius="16" Opacity="0.3" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="16,8" />
    </Style.Setters>
  </Style>

  <!-- Glass Card Style (Modern Glass Effect) -->
  <Style TargetType="Border" x:Key="GlassCard">
    <Style.Setters>
      <Setter Property="Stroke" Value="{StaticResource Stroke}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Background" Value="#1A1E293B" />
      <Setter Property="StrokeShape">
        <Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value>
      </Setter>
      <Setter Property="Shadow">
        <Setter.Value>
          <Shadow Brush="#80000000" Radius="12" Offset="0,6" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="12" />
    </Style.Setters>
  </Style>

  <!-- Search Bar Style (Glass) -->
  <Style TargetType="Border" x:Key="SearchBar">
    <Style.Setters>
      <Setter Property="Background" Value="{StaticResource GlassBackground}" />
      <Setter Property="Stroke" Value="{StaticResource GlassBorder}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeShape">
        <Setter.Value><RoundRectangle CornerRadius="24" /></Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="16,8" />
      <Setter Property="Shadow">
        <Setter.Value>
          <Shadow Brush="{StaticResource Shadow}" Offset="0,2" Radius="8" Opacity="0.2" />
        </Setter.Value>
      </Setter>
    </Style.Setters>
  </Style>

  <!-- Avatar Style -->
  <Style TargetType="Border" x:Key="Avatar">
    <Style.Setters>
      <Setter Property="WidthRequest" Value="40" />
      <Setter Property="HeightRequest" Value="40" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="StrokeShape">
        <Setter.Value><Ellipse /></Setter.Value>
      </Setter>
      <Setter Property="BackgroundColor" Value="{StaticResource ChipBackground}" />
    </Style.Setters>
  </Style>

  <!-- Chip Style (Glass) -->
  <Style TargetType="Border" x:Key="Chip">
    <Style.Setters>
      <Setter Property="Background" Value="{StaticResource GlassBackground}" />
      <Setter Property="Stroke" Value="{StaticResource GlassBorder}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeShape">
        <Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="12,6" />
    </Style.Setters>
  </Style>


  <!-- FAB (Floating Action Button) - Yellow Accent -->
  <Style TargetType="Button" x:Key="FAB">
    <Style.Setters>
      <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
      <Setter Property="TextColor" Value="Black" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="WidthRequest" Value="56" />
      <Setter Property="HeightRequest" Value="56" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Shadow">
        <Setter.Value>
          <Shadow Brush="{StaticResource AccentYellow}" Offset="0,4" Radius="16" Opacity="0.5" />
        </Setter.Value>
      </Setter>
    </Style.Setters>
  </Style>

</ResourceDictionary>
