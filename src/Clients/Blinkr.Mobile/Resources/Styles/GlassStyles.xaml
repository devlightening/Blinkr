<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Glassmorphism Card Style -->
    <Style x:Key="GlassCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassBackground}" />
        <Setter Property="BorderColor" Value="{StaticResource GlassBorder}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="12,8" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource GlassShadow}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom Sheet Style -->
    <Style x:Key="BottomSheet" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="CornerRadius" Value="24,24,0,0" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource GlassShadow}"
                        Offset="0,-4"
                        Radius="16"
                        Opacity="0.15" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Map Pin Style -->
    <Style x:Key="MapPinFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource MapPin}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search Bar Style -->
    <Style x:Key="GlassSearchBar" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassBackground}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource SecondaryDarkText}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Primary}" />
        <Setter Property="Margin" Value="16,12" />
    </Style>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="BorderColor" Value="{StaticResource GlassBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- FAB (Floating Action Button) Style -->
    <Style x:Key="FAB" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
