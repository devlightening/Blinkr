<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Glassmorphism Card Style (Border) -->
    <Style x:Key="GlassCardAlt" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="12,8" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="18" /></Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom Sheet Style (Border) -->
    <Style x:Key="BottomSheet" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="24,24,0,0" /></Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}"
                        Offset="0,-4"
                        Radius="16"
                        Opacity="0.15" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Map Pin Style (Border) -->
    <Style x:Key="MapPinFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value><Ellipse /></Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search Bar Style -->
    <Style x:Key="GlassSearchBar" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Primary}" />
        <Setter Property="Margin" Value="16,12" />
    </Style>

    <!-- Button Styles (Note: PrimaryButton is defined in Styles.xaml, this is an alternative) -->
    <Style x:Key="PrimaryButtonAlt" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource CardStroke}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- FAB (Floating Action Button) Style (Note: FAB is defined in Styles.xaml, this is an alternative) -->
    <Style x:Key="FABAlt" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
