<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Home">
  <VerticalStackLayout Spacing="12" Padding="24" VerticalOptions="Center">
    <Label Text="Blinkr" HorizontalOptions="Center" />
    <Button Text="Ping Backend" Clicked="OnPingClicked"/>
    <Button Text="Ask Location" Clicked="OnLocationClicked"/>
    <Label x:Name="ResultLabel" LineBreakMode="WordWrap"/>
  </VerticalStackLayout>
</ContentPage>

