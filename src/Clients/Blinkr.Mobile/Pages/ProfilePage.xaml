<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Pages.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profil">
  <ScrollView>
    <VerticalStackLayout Spacing="12">
      <Border Style="{StaticResource Card}">
        <HorizontalStackLayout Spacing="12">
          <Image Source="avatar_placeholder.png" 
                 WidthRequest="64" 
                 HeightRequest="64" 
                 Aspect="AspectFill"/>
          <VerticalStackLayout>
            <Label Text="Kullanıcı Adı" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="124 gönderi • 2.5K takipçi • 890 takip" Style="{StaticResource Body}"/>
          </VerticalStackLayout>
        </HorizontalStackLayout>
      </Border>

      <Label Text="mini işı haritası" Style="{StaticResource Body}"/>

      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
        <Image Grid.Column="0" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
        <Image Grid.Column="1" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
        <Image Grid.Column="2" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
        <Image Grid.Row="1" Grid.Column="0" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
        <Image Grid.Row="1" Grid.Column="1" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
        <Image Grid.Row="1" Grid.Column="2" Source="placeholder.png" HeightRequest="80" Aspect="AspectFill"/>
      </Grid>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>

