<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Pages.Old.NotificationsPageOld"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Bildirimler">
  <CollectionView x:Name="NotifList" ItemsLayout="VerticalList">
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Style="{StaticResource Card}">
          <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="10">
            <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFEDE7" StrokeThickness="0">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
              </Border.StrokeShape>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="{Binding Title}" />
              <Label Text="{Binding Body}" Style="{StaticResource Body}"/>
            </VerticalStackLayout>
            <Label Text="{Binding Ago}" Grid.Column="2" Style="{StaticResource Body}"/>
          </Grid>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>

