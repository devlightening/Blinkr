<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Pages.MapPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             Title="Harita">
  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*">
        <Image Source="ic_search.png" WidthRequest="18" Margin="8,0"/>
        <Entry Grid.Column="1" Placeholder="Konum ara..." />
      </Grid>
    </Border>

    <maps:Map Grid.Row="2" x:Name="BlinkrMap" 
              MapType="Street" 
              IsTrafficEnabled="False"
              IsVisible="True"/>
  </Grid>
</ContentPage>

