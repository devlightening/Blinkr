<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Giriş Yap">
  
  <ScrollView>
    <VerticalStackLayout Padding="32" Spacing="24" VerticalOptions="Center">
      
      <!-- Logo/Title -->
      <Label Text="Blinkr" 
             FontSize="48" 
             FontAttributes="Bold" 
             TextColor="{StaticResource AccentYellow}"
             HorizontalOptions="Center"
             Margin="0,0,0,32" />
      
      <!-- Email Entry -->
      <Border Style="{StaticResource GlassCard}">
        <Entry x:Name="EmailEntry"
               Placeholder="E-posta"
               Keyboard="Email"
               TextColor="{StaticResource TextPrimary}"
               PlaceholderColor="{StaticResource TextTertiary}" />
      </Border>
      
      <!-- Password Entry -->
      <Border Style="{StaticResource GlassCard}">
        <Entry x:Name="PasswordEntry"
               Placeholder="Şifre"
               IsPassword="True"
               TextColor="{StaticResource TextPrimary}"
               PlaceholderColor="{StaticResource TextTertiary}" />
      </Border>
      
      <!-- Error Label -->
      <Label x:Name="ErrorLabel"
             TextColor="{StaticResource Danger}"
             IsVisible="False"
             HorizontalOptions="Center" />
      
      <!-- Login Button -->
      <Button x:Name="LoginButton"
              Text="Giriş Yap"
              Style="{StaticResource PrimaryButton}"
              Clicked="OnLoginClicked" />
      
      <!-- Register Link -->
      <Label Text="Hesabın yok mu? Kayıt Ol"
             TextColor="{StaticResource TextSecondary}"
             HorizontalOptions="Center">
        <Label.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnRegisterTapped" />
        </Label.GestureRecognizers>
      </Label>
      
    </VerticalStackLayout>
  </ScrollView>
  
</ContentPage>

