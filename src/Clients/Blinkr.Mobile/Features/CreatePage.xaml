<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.CreatePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Oluştur">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Page Title with Back Button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="16,16,16,8">
            <Label Grid.Column="0"
                   Text="←"
                   FontSize="24"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center"
                   Margin="0,0,16,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelClicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Text="Oluştur"
                   Style="{StaticResource PageTitle}"
                   Margin="0" />
        </Grid>
        
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="0" Padding="0">
                
                <!-- Photo/Video Section -->
                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Margin="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="200,Auto" Padding="16">
                        <!-- Photo Preview Area -->
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource ChipBackground}"
                                StrokeThickness="0"
                                HeightRequest="200">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid>
                                <Image x:Name="PhotoPreview"
                                       Aspect="AspectFill"
                                       IsVisible="False" />
                                <Border BackgroundColor="{StaticResource TextPrimary}"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Label Text="📷"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSelectMediaClicked" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Title & Description Section -->
                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Margin="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <StackLayout Spacing="12" Padding="16">
                        <Entry x:Name="TitleEntry"
                               Placeholder="Başlıl"
                               FontSize="16"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextTertiary}" />
                        
                        <Border BackgroundColor="{StaticResource ChipBackground}"
                                StrokeThickness="0"
                                Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Editor x:Name="ContentEditor"
                                    Placeholder="Açıklama"
                                    HeightRequest="100"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextTertiary}" />
                        </Border>
                    </StackLayout>
                </Border>

                <!-- Location Section -->
                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Margin="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <StackLayout Spacing="12" Padding="16">
                        <Label Text="Konum"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   x:Name="LocationLabel"
                                   Text="Kesin (~1.2 km)"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            
                            <Switch Grid.Column="1"
                                    x:Name="LocationSwitch"
                                    IsToggled="True"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                    </StackLayout>
                </Border>

                <!-- Submit Button -->
                <Button Text="Gönder"
                        Style="{StaticResource PrimaryButton}"
                        Margin="16,16,16,32"
                        Clicked="OnPostClicked" />

            </StackLayout>
        </ScrollView>
        
    </Grid>
</ContentPage>
