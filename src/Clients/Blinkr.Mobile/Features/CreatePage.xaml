<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.CreatePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource BlinkrBackground}"
             Title="Oluştur">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Header with Back Button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,24,24,16">
            <Button Grid.Column="0"
                    Text="←"
                    Style="{StaticResource IconButton}"
                    Clicked="OnCancelClicked"
                    Margin="0,0,12,0" />
            <Label Grid.Column="1"
                   Text="Oluştur"
                   Style="{StaticResource H1}"
                   TextColor="{StaticResource BlinkrAccent}"
                   VerticalOptions="Center" />
        </Grid>
        
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- Media Picker Card -->
                <Border Style="{StaticResource CardContainer}" 
                        HeightRequest="180">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSelectMediaClicked"/>
                    </Border.GestureRecognizers>
                    
                    <VerticalStackLayout VerticalOptions="Center" 
                                        HorizontalOptions="Center" 
                                        Spacing="8">
                        <Label Text="📷" 
                               FontSize="32" 
                               HorizontalOptions="Center" />
                        <Label Text="Fotoğraf veya video ekle"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Title Entry -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Başlık"
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Entry x:Name="TitleEntry" 
                           Placeholder="Başlık girin..."
                           Style="{StaticResource ModernEntry}" />
                </VerticalStackLayout>

                <!-- Content Editor -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="İçerik"
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Editor x:Name="ContentEditor" 
                            Placeholder="Neler oluyor?"
                            BackgroundColor="{StaticResource BlinkrCardBackground}"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextTertiary}"
                            FontSize="14"
                            HeightRequest="100"
                            AutoSize="TextChanges"/>
                </VerticalStackLayout>

                <!-- Location Indicator Card -->
                <Border Style="{StaticResource CardContainer}" Padding="16,12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="📍" 
                               FontSize="18" 
                               VerticalOptions="Center" />
                        <Label Text="{Binding CurrentLocationName, FallbackValue='Konum alınamadı'}"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Send Button -->
                <Button Text="Gönder" 
                        Style="{StaticResource PrimaryButton}" 
                        Clicked="OnPostClicked"
                        Margin="0,12,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>
</ContentPage>
