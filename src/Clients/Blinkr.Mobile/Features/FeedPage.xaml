<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.FeedPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Akış"
             BackgroundColor="{StaticResource BlinkrBackground}">

    <Grid RowDefinitions="Auto,*" Padding="0">
        
        <!-- Header with Search & Notifications -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="24,24,24,16" RowSpacing="12" BackgroundColor="{StaticResource BlinkrBackground}">
            <VerticalStackLayout Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                <Label Text="Akış"
                       Style="{StaticResource H1}"
                       TextColor="{StaticResource BlinkrAccent}" />
                <Label Text="Çevrendeki anlık paylaşımları keşfet"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            
            <!-- Search Icon -->
            <Button Grid.Column="1" 
                    Text="🔍" 
                    Style="{StaticResource IconButton}"
                    Margin="0,0,8,0" />
            
            <!-- Notifications Icon -->
            <Button Grid.Column="2" 
                    Text="🔔" 
                    Style="{StaticResource IconButton}" />
        </Grid>
        
        <!-- Posts List -->
        <CollectionView Grid.Row="1"
                        x:Name="PostsCollectionView"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="None"
                        Margin="16,0,16,20">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardContainer}" Margin="0,8">
                        <VerticalStackLayout Spacing="12">
                            
                            <!-- Post Header: Avatar + Author Info -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{StaticResource BlinkrCardBackground}">
                                    <Label Text="👤"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <!-- Author Name & Meta -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding AuthorName}"
                                           Style="{StaticResource Body1Bold}"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding CreatedAtUtc, StringFormat='{0:g}'}"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                
                                <!-- More Options -->
                                <Label Grid.Column="2"
                                       Text="⋮"
                                       FontSize="18"
                                       TextColor="{StaticResource TextTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            
                            <!-- Post Title -->
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource Body1Bold}"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation" />
                            
                            <!-- Post Content (max 3 lines) -->
                            <Label Text="{Binding Content}"
                                   Style="{StaticResource Body1}"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3" />
                            
                            <!-- Location Info -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="📍"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding LocationName}"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            
                            <!-- Action Bar: Like + Comment + Share -->
                            <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                                <!-- Like -->
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="❤️" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="{Binding LikeCount}"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource TextSecondary}" />
                                </HorizontalStackLayout>
                                
                                <!-- Comment -->
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="💬" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="{Binding CommentCount}"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource TextSecondary}" />
                                </HorizontalStackLayout>
                                
                                <!-- Share -->
                                <Label Text="↗" FontSize="14" HorizontalOptions="EndAndExpand" />
                            </HorizontalStackLayout>
                            
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
