<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.FeedPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Akış">

    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Page Title -->
        <Label Grid.Row="0"
               Text="Akış"
               Style="{StaticResource PageTitle}" />
        
        <!-- Filter Tabs (Sırala) -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                Margin="0">
            <HorizontalStackLayout Spacing="8" Padding="16,12" HorizontalOptions="Center">
                <Label Text="Sırala:" 
                       FontSize="14" 
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center"
                       Margin="0,0,8,0" />
                <Button x:Name="BtnYakin"
                        Text="Yakın"
                        Style="{StaticResource TabButtonActive}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="BtnPopuler"
                        Text="Popüler"
                        Style="{StaticResource TabButton}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="BtnYeni"
                        Text="Yeni"
                        Style="{StaticResource TabButton}"
                        Clicked="OnFilterClicked" />
            </HorizontalStackLayout>
        </Border>

        <!-- Posts List -->
        <CollectionView Grid.Row="2"
                        x:Name="PostsCollectionView"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="None">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*">
                            
                            <!-- Post Header with Map Thumbnail -->
                            <Grid Grid.Row="0" ColumnDefinitions="60,*,Auto">
                                <!-- Map Thumbnail -->
                                <Border Grid.Column="0"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Border}"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource ChipBackground}">
                                    <Label Text="🗺️"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <!-- Location & Distance -->
                                <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding LocationName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Distance}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                </StackLayout>
                                
                                <!-- More Options -->
                                <Label Grid.Column="2"
                                       Text="⋮"
                                       FontSize="20"
                                       TextColor="{StaticResource TextTertiary}"
                                       VerticalOptions="Start" />
                            </Grid>

                            <!-- Post Title -->
                            <Label Grid.Row="1"
                                   Text="{Binding Title}"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0,12,0,4" />
                            
                            <!-- Post Content -->
                            <Label Grid.Row="2"
                                   Text="{Binding Content}"
                                   Style="{StaticResource Body}"
                                   Margin="0,0,0,12" />

                            <!-- Action Buttons -->
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                                <!-- Like Button -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource Avatar}"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        BackgroundColor="Transparent">
                                    <Label Text="❤️"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <Label Grid.Column="1"
                                       Text="{Binding LikeText}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"
                                       Margin="4,0,16,0" />
                                
                                <!-- Comment Button -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource Avatar}"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        BackgroundColor="Transparent">
                                    <Label Text="💬"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <Label Grid.Column="3"
                                       Text="{Binding CommentText}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"
                                       Margin="4,0,0,0" />
                                
                                <!-- Share Button -->
                                <Border Grid.Column="5"
                                        Style="{StaticResource Avatar}"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        BackgroundColor="Transparent">
                                    <Label Text="↗️"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <Label Grid.Column="6"
                                       Text="{Binding ShareText}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"
                                       Margin="4,0,0,0" />
                            </Grid>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
