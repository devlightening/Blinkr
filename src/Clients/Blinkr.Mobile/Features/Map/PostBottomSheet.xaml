<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Blinkr.Mobile.Features.Map.PostBottomSheet"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Blinkr.Mobile.Core.Api">

    <!-- Glass Bottom Sheet -->
    <Border Style="{StaticResource BottomSheet}"
           x:Name="SheetFrame">
        
        <StackLayout Spacing="16">
            
            <!-- Handle Bar -->
            <Border WidthRequest="40"
                     HeightRequest="4"
                     BackgroundColor="{StaticResource Gray300}"
                     HorizontalOptions="Center"
                     StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="2" />
                </Border.StrokeShape>
            </Border>
            
            <!-- Post Header -->
            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12">
                
                <!-- Author Avatar -->
                <Border Grid.Column="0"
                       WidthRequest="40"
                       HeightRequest="40"
                       BackgroundColor="{StaticResource Primary}"
                       StrokeShape="Ellipse"
                       StrokeThickness="0">
                    <Label Text="👤"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="20"
                           TextColor="White" />
                </Border>
                
                <!-- Author Info -->
                <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding AuthorName}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Yakında"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </StackLayout>
                
                <!-- More Options -->
                <Button Grid.Column="2"
                        Text="⋯"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40" />
            </Grid>

            <!-- Post Content -->
            <StackLayout Spacing="8">
                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="WordWrap" />
                
                <Label Text="{Binding Content}"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap"
                       MaxLines="3" />
                
                <!-- Created Date -->
                <Label Text="{Binding CreatedAtText}"
                       FontSize="12"
                       TextColor="{StaticResource TextTertiary}" />
            </StackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="16">
                
                <!-- Like Button -->
                <Button Grid.Column="0"
                        Text="❤️"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource LikeRed}"
                        FontSize="20"
                        WidthRequest="40"
                        Command="{Binding LikeCommand}" />
                
                <!-- Like Count -->
                <Label Grid.Column="1"
                       Text="{Binding LikeCount, StringFormat='{0}'}"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center" />
                
                <!-- Spacer -->
                
                <!-- Comment Button -->
                <Button Grid.Column="3"
                        Text="💬"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="20"
                        WidthRequest="40"
                        Command="{Binding CommentCommand}" />
                
                <!-- Share Button -->
                <Button Grid.Column="4"
                        Text="📤"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="20"
                        WidthRequest="40"
                        Command="{Binding ShareCommand}" />
            </Grid>

            <!-- Quick Actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Yorum Yap"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14" />
                
                <Button Grid.Column="1"
                        Text="Yol Tarifi"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14" />
            </Grid>
            
        </StackLayout>
    </Border>
</ContentView>
