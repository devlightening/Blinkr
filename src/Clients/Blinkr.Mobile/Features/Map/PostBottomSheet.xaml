<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Blinkr.Mobile.Features.Map.PostBottomSheet"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Blinkr.Mobile.Core.Api">

    <!-- Modern Glass Bottom Sheet -->
    <Border Style="{StaticResource BottomSheet}"
           x:Name="SheetFrame">
        
        <ScrollView>
            <StackLayout Spacing="0">
            
                <!-- Handle Bar -->
                <Border WidthRequest="40"
                         HeightRequest="4"
                         BackgroundColor="{StaticResource Gray300}"
                         HorizontalOptions="Center"
                         Margin="0,8,0,16"
                         StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="2" />
                    </Border.StrokeShape>
                </Border>
                
                <!-- Media Carousel (if available) -->
                <CarouselView ItemsSource="{Binding Media}"
                              HeightRequest="250"
                              IndicatorView="indicatorView"
                              IsVisible="{Binding HasMedia}"
                              Margin="0,0,0,16">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource Gray100}">
                                <Image Source="{Binding Url}"
                                       Aspect="AspectFill" />
                            </Border>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                
                <!-- Carousel Indicators -->
                <IndicatorView x:Name="indicatorView"
                               IndicatorColor="{StaticResource Gray300}"
                               SelectedIndicatorColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,0,0,16"
                               IsVisible="{Binding HasMedia}" />
            
                <!-- Post Header -->
                <Grid ColumnDefinitions="50,*,Auto" 
                      ColumnSpacing="12"
                      Padding="16,0"
                      Margin="0,0,0,16">
                
                    <!-- Author Avatar -->
                    <Border Grid.Column="0"
                           WidthRequest="44"
                           HeightRequest="44"
                           BackgroundColor="{StaticResource Gray200}"
                           StrokeShape="Ellipse"
                           StrokeThickness="2"
                           Stroke="{StaticResource Primary}">
                        <Grid>
                            <!-- Avatar image (if available) -->
                            <Image Source="{Binding AuthorAvatarUrl}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding HasAvatar}" />
                            
                            <!-- Fallback icon (if no avatar) -->
                            <Label Text="👤"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="22"
                                   TextColor="{StaticResource Primary}"
                                   IsVisible="{Binding HasNoAvatar}" />
                        </Grid>
                    </Border>
                
                    <!-- Author Info -->
                    <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding AuthorName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding RelativeTime}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1"
                                   Text="{Binding LocationName}"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}"
                                   IsVisible="{Binding HasLocation}" />
                        </Grid>
                    </StackLayout>
                
                <!-- More Options -->
                <Button Grid.Column="2"
                        Text="⋯"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40" />
            </Grid>

                <!-- Post Content -->
                <StackLayout Spacing="12" Padding="16,0" Margin="0,0,0,16">
                    <Label Text="{Binding Title}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           LineBreakMode="WordWrap" />
                    
                    <Label Text="{Binding Content}"
                           FontSize="15"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           MaxLines="5" />
                </StackLayout>

                <!-- Stats & Actions -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" 
                      ColumnSpacing="20"
                      Padding="16,0"
                      Margin="0,0,0,16">
                
                    <!-- Like -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <Button Text="❤️"
                                BackgroundColor="Transparent"
                                FontSize="22"
                                Padding="0"
                                WidthRequest="32"
                                HeightRequest="32"
                                Command="{Binding LikeCommand}" />
                        <Label Text="{Binding LikeCount}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                
                <!-- Spacer -->
                
                    <!-- Comment -->
                    <HorizontalStackLayout Grid.Column="3" Spacing="8">
                        <Button Text="💬"
                                BackgroundColor="Transparent"
                                FontSize="22"
                                Padding="0"
                                WidthRequest="32"
                                HeightRequest="32"
                                Command="{Binding CommentCommand}" />
                        <Label Text="{Binding CommentCount}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                    <!-- Share -->
                    <Button Grid.Column="4"
                            Text="📤"
                            BackgroundColor="Transparent"
                            FontSize="22"
                            Padding="0"
                            WidthRequest="32"
                            HeightRequest="32"
                            Command="{Binding ShareCommand}" />
            </Grid>

                <!-- Quick Actions -->
                <Grid ColumnDefinitions="*,*" 
                      ColumnSpacing="12"
                      Padding="16,0,16,16">
                    <Button Grid.Column="0"
                            Text="Yorum Yap"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="15"
                            HeightRequest="48" />
                    
                    <Button Grid.Column="1"
                            Text="Yol Tarifi"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="15"
                            HeightRequest="48" />
                </Grid>
                
            </StackLayout>
        </ScrollView>
    </Border>
</ContentView>
