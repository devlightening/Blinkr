<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Blinkr.Mobile.Features.Map.MapPinView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <!-- Avatarlı Pin Template -->
    <Grid WidthRequest="50" HeightRequest="60">
        
        <!-- Pin Shadow -->
        <Ellipse Fill="{StaticResource Shadow}"
                 WidthRequest="20"
                 HeightRequest="8"
                 VerticalOptions="End"
                 Opacity="0.3" />
        
        <!-- Pin Body -->
        <Border x:Name="PinBorder"
                WidthRequest="40"
                HeightRequest="40"
                StrokeThickness="3"
                Stroke="White"
                BackgroundColor="{StaticResource MapPin}"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            
            <!-- Avatar or Count -->
            <Grid>
                <!-- Single Post Avatar -->
                <Label x:Name="AvatarLabel"
                       Text="👤"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding IsSinglePost}" />
                
                <!-- Multiple Posts Count -->
                <Label x:Name="CountLabel"
                       Text="{Binding PostCount}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding IsCluster}" />
            </Grid>
        </Border>
        
        <!-- Pin Pointer -->
        <Polygon x:Name="PinPointer"
                 Points="20,35 25,45 15,45"
                 Fill="{StaticResource MapPin}"
                 VerticalOptions="Start"
                 HorizontalOptions="Center" />
    </Grid>
</ContentView>
