<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.NotificationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Bildirimler"
             BackgroundColor="{StaticResource Background}">

    <StackLayout>
        <!-- Header -->
        <Label Text="Daha Önce"
               FontSize="14"
               TextColor="{StaticResource TextSecondary}"
               Margin="16,16,16,8" />

        <!-- Notifications List -->
        <CollectionView x:Name="NotificationsCollectionView"
                        ItemsSource="{Binding Notifications}"
                        BackgroundColor="Transparent">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GlassCard}"
                           Margin="12,4">
                        <Grid ColumnDefinitions="50,*,Auto,Auto">
                            
                            <!-- User Avatar -->
                            <Border Grid.Column="0"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   BackgroundColor="{Binding AvatarColor}"
                                   StrokeShape="Ellipse"
                                   StrokeThickness="0">
                                <Label Text="{Binding Avatar}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                            </Border>
                            
                            <!-- Notification Content -->
                            <StackLayout Grid.Column="1" 
                                         Spacing="4"
                                         VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Message}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </StackLayout>
                            
                            <!-- Action Icon -->
                            <Label Grid.Column="2"
                                   Text="{Binding ActionIcon}"
                                   FontSize="16"
                                   TextColor="{Binding ActionColor}"
                                   VerticalOptions="Center"
                                   Margin="8,0" />
                            
                            <!-- Time -->
                            <Label Grid.Column="3"
                                   Text="{Binding TimeAgo}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>
</ContentPage>
