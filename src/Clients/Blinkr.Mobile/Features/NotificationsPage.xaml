<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.NotificationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Bildirimler"
             BackgroundColor="{StaticResource BlinkrBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Padding="24,24,24,12" ColumnDefinitions="*,Auto">
            <Label Text="Bildirimler"
                   Style="{StaticResource H1}"
                   VerticalOptions="Center" />
            <Button Text="Tümünü Oku"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,8"
                    Command="{Binding MarkAllAsReadCommand}" />
        </Grid>

        <!-- LIST -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Notifications}"
                        Margin="16,0,16,16">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource NotificationCardBorder}"
                            Margin="0,8">

                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <!-- ICON -->
                            <Frame Grid.RowSpan="2"
                                   WidthRequest="40" HeightRequest="40"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   Padding="0"
                                   BackgroundColor="#1F2432">
                                <Label Text="{Binding Icon}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="20" />
                            </Frame>

                            <!-- TITLE -->
                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   Style="{StaticResource Body1}" />

                            <!-- TIME -->
                            <Label Grid.Column="2"
                                   Text="{Binding TimeAgo}"
                                   Style="{StaticResource Body2}"
                                   HorizontalTextAlignment="End" />

                            <!-- MESSAGE -->
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Message}"
                                   Style="{StaticResource Body2}" />

                            <!-- UNREAD DOT -->
                            <BoxView Grid.Row="1" Grid.Column="2"
                                     WidthRequest="8" HeightRequest="8"
                                     CornerRadius="4"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End"
                                     Color="{StaticResource NotificationUnreadDot}"
                                     IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
