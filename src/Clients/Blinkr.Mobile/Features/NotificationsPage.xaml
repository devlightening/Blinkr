<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.NotificationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Bildirimler"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- Status Message -->
        <Label Grid.Row="0"
               Text="{Binding StatusMessage}"
               FontSize="14"
               TextColor="{StaticResource TextSecondary}"
               Margin="16,16,16,8"
               IsVisible="{Binding IsBusy}" />

        <!-- Notifications List with Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Notifications}"
                            BackgroundColor="Transparent">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GlassCard}"
                           Margin="12,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}" />
                        </Border.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="50,*,Auto">
                            
                            <!-- Notification Icon -->
                            <Border Grid.Column="0"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   BackgroundColor="{StaticResource Primary}"
                                   StrokeShape="Ellipse"
                                   StrokeThickness="0">
                                <Label Text="🔔"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                            </Border>
                            
                            <!-- Notification Content -->
                            <StackLayout Grid.Column="1" 
                                         Spacing="4"
                                         VerticalOptions="Center"
                                         Margin="12,0">
                                <Label Text="{Binding DisplayTitle}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Body}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       MaxLines="2" />
                            </StackLayout>
                            
                            <!-- Time -->
                            <Label Grid.Column="2"
                                   Text="{Binding RelativeTime}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Start"
                                   Margin="8,4" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
