<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource AppBackgroundDark}"
             Title="Profil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,20,0,0">
                <Border Stroke="{StaticResource NeonYellow}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 60"
                        HeightRequest="120"
                        WidthRequest="120"
                        HorizontalOptions="Center"
                        BackgroundColor="{StaticResource CardDark}">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource NeonYellow}" Radius="25" Opacity="0.5" Offset="0,0"/>
                    </Border.Shadow>
                    <Label Text="👤" FontSize="60" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Label Text="Jaram Sabatt" 
                       TextColor="White" 
                       FontSize="22" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" Margin="0,10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="124" TextColor="{StaticResource NeonYellow}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="gönderi" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="2.5K" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="takipçi" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="890" TextColor="{StaticResource NeonYellow}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="takip edilen" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <Button Text="Ayarlar" 
                    Style="{StaticResource NeonButtonStyle}"
                    HorizontalOptions="Center"
                    WidthRequest="200"/>

            <Label Text="Mini işi haritası" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   FontSize="16"
                   Margin="0,10,0,0"/>

            <Grid RowDefinitions="110, 110" ColumnDefinitions="*,*" ColumnSpacing="15" RowSpacing="15">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DarkCardBox}">
                    <Label Text="📍" VerticalOptions="Center" HorizontalOptions="Center" FontSize="30"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkCardBox}">
                     <Label Text="💬" VerticalOptions="Center" HorizontalOptions="Center" FontSize="30" TextColor="#42A5F5"/>
                </Border>
                 <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DarkCardBox}">
                     <Label Text="🌲" VerticalOptions="Center" HorizontalOptions="Center" FontSize="30"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkCardBox}">
                     <Label Text="⚙️" VerticalOptions="Center" HorizontalOptions="Center" FontSize="30" TextColor="Gray"/>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
