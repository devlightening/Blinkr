<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profil">

    <ScrollView>
        <StackLayout Spacing="0" Padding="0">
            
            <!-- Page Title -->
            <Label Text="Profil"
                   Style="{StaticResource PageTitle}" />
            
            <!-- Profile Header -->
            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Margin="16,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <StackLayout Spacing="16" Padding="16" HorizontalOptions="Center">
                    
                    <!-- Profile Picture with Border -->
                    <Border WidthRequest="90"
                            HeightRequest="90"
                            StrokeThickness="3"
                            Stroke="{StaticResource Primary}"
                            BackgroundColor="{StaticResource ChipBackground}"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SuccessMint}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Label Text="👤"
                                   FontSize="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Border>
                    
                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,*,*" 
                          ColumnSpacing="32"
                          Margin="0,8,0,0">
                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="124"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="gönderi"
                                   Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                        
                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="2.5K"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="takipçi"
                                   Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                        
                        <StackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="890"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="takip edillen"
                                   Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Grid>
                    
                    <!-- Filter Tabs -->
                    <HorizontalStackLayout Spacing="8" Padding="0,8,0,0" HorizontalOptions="Center">
                        <Label Text="Sırala:" 
                               FontSize="14" 
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Button Text="Yakın"
                                Style="{StaticResource TabButtonActive}" />
                        <Button Text="Popüler"
                                Style="{StaticResource TabButton}" />
                        <Button Text="Yeni"
                                Style="{StaticResource TabButton}" />
                    </HorizontalStackLayout>
                </StackLayout>
            </Border>

            <!-- Photo Grid -->
            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Margin="16,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <StackLayout Spacing="12" Padding="16">
                    <Label Text="mini işi haritası"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    
                    <!-- 2x3 Photo Grid -->
                    <Border BackgroundColor="Transparent"
                            StrokeThickness="2"
                            Stroke="{StaticResource Primary}"
                            Padding="8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="100,100" 
                              ColumnDefinitions="*,*,*"
                              RowSpacing="8"
                              ColumnSpacing="8">
                            
                            <Border Grid.Row="0" Grid.Column="0"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🏛️"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                            
                            <Border Grid.Row="0" Grid.Column="1"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🌅"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                            
                            <Border Grid.Row="0" Grid.Column="2"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🏛️"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="0"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🌆"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="1"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🏙️"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="2"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="🌉"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="30" />
                            </Border>
                        </Grid>
                    </Border>
                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>
