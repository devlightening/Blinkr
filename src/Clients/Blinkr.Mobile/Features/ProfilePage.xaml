<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource BlinkrBackground}"
             Title="Profil">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- Hero Header: Avatar + Username -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <!-- Avatar with Yellow Border -->
                <Border StrokeThickness="3"
                        Stroke="{StaticResource BlinkrAccent}"
                        StrokeShape="RoundRectangle 48"
                        HeightRequest="96"
                        WidthRequest="96"
                        HorizontalOptions="Center"
                        BackgroundColor="{StaticResource BlinkrCardBackground}">
                    <Label Text="👤" 
                           FontSize="48" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Border>

                <!-- Username -->
                <Label Text="{Binding UserName}" 
                       Style="{StaticResource HeadlineMedium}"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"/>
                
                <!-- Email/Handle -->
                <Label Text="{Binding Email}" 
                       Style="{StaticResource BodySmall}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Stats Bar -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- Posts Count -->
                <Border Grid.Column="0" Style="{StaticResource CardContainer}" Padding="16,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding PostCount, StringFormat='{0}'}" 
                               Style="{StaticResource TitleMedium}"
                               TextColor="{StaticResource BlinkrAccent}"
                               HorizontalOptions="Center"/>
                        <Label Text="Gönderi" 
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Followers Count -->
                <Border Grid.Column="1" Style="{StaticResource CardContainer}" Padding="16,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="0" 
                               Style="{StaticResource TitleMedium}"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Takipçi" 
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Following Count -->
                <Border Grid.Column="2" Style="{StaticResource CardContainer}" Padding="16,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="0" 
                               Style="{StaticResource TitleMedium}"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Takip Edilen" 
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Settings Button -->
            <Button Text="Ayarlar" 
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0" />

            <!-- Mini Map Card -->
            <Border Style="{StaticResource CardContainer}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Son Konumlar" 
                           Style="{StaticResource TitleMedium}"
                           TextColor="{StaticResource TextPrimary}"/>
                    
                    <Border HeightRequest="120"
                            BackgroundColor="{StaticResource BlinkrCardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Label Text="🗺️ Mini Harita"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{StaticResource TextSecondary}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
