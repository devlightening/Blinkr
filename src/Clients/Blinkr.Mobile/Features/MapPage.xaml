<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Blinkr.Mobile.Features.Map"
             x:Class="Blinkr.Mobile.Features.MapPage"
             x:DataType="vm:MapViewModel"
             Title="Harita"
             BackgroundColor="{StaticResource BlinkrBackground}"
             Padding="0">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" 
                            Padding="24,24,24,12" 
                            Spacing="4"
                            BackgroundColor="{StaticResource BlinkrBackground}">
            <Label Text="Harita" 
                   Style="{StaticResource H1}"
                   TextColor="{StaticResource BlinkrAccent}" />
            <Label Text="Yakınındaki paylaşımları keşfet" 
                   Style="{StaticResource Body2}"
                   TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <!-- MAP CONTAINER -->
        <Grid Grid.Row="1">
            <WebView x:Name="MapWebView"
                     Navigating="OnWebViewNavigating"
                     Navigated="OnWebViewNavigated"
                     Margin="0" />

            <!-- Floating Action Buttons (Right side) -->
            <VerticalStackLayout HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Spacing="12"
                                 Margin="0,0,16,0">
                <!-- Refresh Button -->
                <Button Text="⟳"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{StaticResource BlinkrAccent}"
                        TextColor="{StaticResource TextInverse}"
                        FontSize="20"
                        Command="{Binding LoadNearbyCommand}" />

                <!-- My Location Button -->
                <Button Text="📍"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{StaticResource BlinkrCardBackground}"
                        TextColor="{StaticResource BlinkrAccent}"
                        FontSize="20"
                        BorderColor="{StaticResource BlinkrAccent}"
                        BorderWidth="1" />
            </VerticalStackLayout>
        </Grid>

        <!-- BOTTOM SHEET CARD -->
        <Border Grid.Row="2"
                Style="{StaticResource BottomSheet}"
                Margin="0"
                Padding="0"
                IsVisible="{Binding IsBottomSheetVisible}">

            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="20,16,20,20">

                    <!-- Drag Handle -->
                    <BoxView WidthRequest="40" 
                             HeightRequest="4"
                             BackgroundColor="{StaticResource DividerColor}"
                             CornerRadius="2"
                             HorizontalOptions="Center"
                             Margin="0,4,0,8" />

                    <!-- User Info Section -->
                    <HorizontalStackLayout Spacing="12">
                        <!-- Avatar -->
                        <Border WidthRequest="48" 
                                HeightRequest="48"
                                BackgroundColor="{StaticResource BlinkrCardBackground}"
                                StrokeThickness="2"
                                Stroke="{StaticResource BlinkrAccent}"
                                Padding="0"
                                StrokeShape="RoundRectangle 24">
                            <Label Text="👤"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- User Details -->
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPostDetail.AuthorName, FallbackValue='Blinkr User'}"
                                   Style="{StaticResource Body1Bold}"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding SelectedPostDetail.LocationName, FallbackValue='Konum'}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Post Title -->
                    <Label Text="{Binding SelectedPostDetail.Title, FallbackValue='Post'}"
                           Style="{StaticResource Body1Bold}"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- Post Description -->
                    <Label Text="{Binding SelectedPostDetail.Content}"
                           Style="{StaticResource Body1}"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           MaxLines="4" />

                    <!-- Stats Row -->
                    <HorizontalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="❤️" FontSize="14" />
                            <Label Text="{Binding SelectedPostDetail.LikeCount, StringFormat='{0}'}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource TextSecondary}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="4">
                            <Label Text="💬" FontSize="14" />
                            <Label Text="{Binding SelectedPostDetail.CommentCount, StringFormat='{0}'}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource TextSecondary}" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Action Buttons -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="📞"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="FillAndExpand" />

                        <Button Text="💬"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="FillAndExpand" />

                        <Button Text="ℹ️"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>

                    <!-- Directions Button -->
                    <Button Text="🗺️ Yol Tarifi"
                            Style="{StaticResource PrimaryButton}" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>