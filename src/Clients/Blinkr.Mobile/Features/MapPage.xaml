<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blinkr.Mobile.Features.MapPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:map="clr-namespace:Blinkr.Mobile.Features.Map"
             Title="Harita"
             BackgroundColor="{StaticResource Secondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status and Controls -->
        <StackLayout Grid.Row="0" Spacing="8" Padding="16">
            <Label Text="{Binding StatusMessage}" 
                   FontSize="14" 
                   TextColor="{StaticResource PrimaryDarkText}"
                   HorizontalOptions="Center" />
            
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="Login"
                        Command="{Binding LoginCommand}"
                        IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" />
                
                <Button Grid.Column="1"
                        Text="Load Nearby"
                        Command="{Binding LoadNearbyCommand}"
                        IsEnabled="{Binding IsAuthenticated}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="12" />
                
                <Button Grid.Column="2"
                        Text="Logout"
                        Command="{Binding LogoutCommand}"
                        IsVisible="{Binding IsAuthenticated}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="12" />
            </Grid>
        </StackLayout>

        <!-- Map -->
        <maps:Map Grid.Row="1"
                  x:Name="MainMap"
                  MapType="Street"
                  IsShowingUser="True"
                  IsScrollEnabled="True"
                  IsZoomEnabled="True">
            
            <!-- Map will be populated with pins programmatically -->
            
        </maps:Map>

        <!-- Bottom Sheet for Post Details -->
        <map:PostBottomSheet Grid.Row="1"
                             x:Name="BottomSheet"
                             VerticalOptions="End"
                             IsVisible="False" />

        <!-- FAB for Create Post -->
        <Button Grid.Row="1"
                Text="+"
                Style="{StaticResource FAB}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20,20,20,100"
                Clicked="OnCreatePostClicked" />

    </Grid>
</ContentPage>
