<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Blinkr.Mobile.Features.MapPage"
             Title="Harita">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

    <!-- Arama kapsülü -->
    <Border Style="{StaticResource Card}" Margin="0,4,0,8" Padding="10" StrokeThickness="0">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Image Source="ic_search.png" WidthRequest="20" HeightRequest="20" Opacity="0.6"/>
        <Entry Grid.Column="1" Placeholder="Konum ara..." BackgroundColor="Transparent" />
      </Grid>
    </Border>

    <!-- Google Harita -->
    <maps:Map x:Name="BlinkrMap"
              Grid.Row="1"
              IsTrafficEnabled="False"
              MapType="Street"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand"/>
  </Grid>
</ContentPage>
