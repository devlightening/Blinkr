<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:map="clr-namespace:Blinkr.Mobile.Features.Map"
             xmlns:vm="clr-namespace:Blinkr.Mobile.Features.Map"
             x:Class="Blinkr.Mobile.Features.MapPage"
             x:DataType="vm:MapViewModel"
             Title="Harita"
             BackgroundColor="{StaticResource Background}">

  <Grid>
    <!-- Leaflet Harita (WebView) -->
    <WebView x:Name="MapWebView"
             VerticalOptions="FillAndExpand"
             HorizontalOptions="FillAndExpand"
             Navigating="OnWebViewNavigating"
             Navigated="OnWebViewNavigated" />

    <!-- Status Message -->
    <Border Background="{StaticResource GlassBackground}"
            Stroke="{StaticResource GlassBorder}"
            StrokeThickness="1"
            Padding="16,12"
            Margin="16"
            VerticalOptions="End"
            HorizontalOptions="Center"
            IsVisible="{Binding IsBusy}">
      <Border.StrokeShape>
        <RoundRectangle CornerRadius="24" />
      </Border.StrokeShape>
      <Label Text="{Binding StatusMessage}"
             TextColor="{StaticResource TextPrimary}"
             FontSize="14" />
    </Border>

    <!-- Bottom Sheet - Max height to leave map buttons accessible (FAB buttons are at bottom right) -->
    <map:PostBottomSheet x:Name="BottomSheet"
                         Post="{Binding SelectedPostDetail}"
                         VerticalOptions="End"
                         TranslationY="500"
                         ZIndex="1"
                         MaximumHeightRequest="400"
                         IsVisible="{Binding IsBottomSheetVisible}" />
  </Grid>
</ContentPage>
