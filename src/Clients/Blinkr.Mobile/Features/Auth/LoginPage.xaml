<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blinkr.Mobile.Features.Auth.LoginPage"
             Title="Blinkr"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto,*" Padding="0">
        <!-- Top Gradient Decoration -->
        <BoxView Grid.Row="0" 
                 BackgroundColor="#1A1F27" 
                 Opacity="0.3"/>

        <!-- Main Content -->
        <ScrollView Grid.Row="0" Grid.RowSpan="3">
            <VerticalStackLayout Padding="24" Spacing="0" VerticalOptions="Center">
                
                <!-- Logo Section -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,40">
                    <Label Text="✨ Blinkr" 
                           FontSize="48" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.2"/>
                    <Label Text="Etrafındaki Hikayeler" 
                           FontSize="14" 
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center"
                           Opacity="0.7"/>
                </VerticalStackLayout>

                <!-- Glass Card Container -->
                <Frame BorderColor="#2A2F37" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="False"
                       BackgroundColor="#0F1419"
                       Margin="0,0,0,24">
                    <VerticalStackLayout Padding="24" Spacing="16">
                        
                        <!-- Email Input -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="E-posta" 
                                   FontSize="12" 
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   FontAttributes="Bold"
                                   Opacity="0.8"/>
                            <Frame BorderColor="#2A2F37" 
                                   CornerRadius="12" 
                                   Padding="0" 
                                   HasShadow="False"
                                   BackgroundColor="#16191F">
                                <Entry x:Name="EmailEntry"
                                       Placeholder="ornek@email.com"
                                       PlaceholderColor="#6B7280"
                                       TextColor="{StaticResource OnSurface}"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email"
                                       Margin="16,12,16,12"
                                       FontSize="14"/>
                            </Frame>
                        </VerticalStackLayout>
                        
                        <!-- Password Input -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Şifre" 
                                   FontSize="12" 
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   FontAttributes="Bold"
                                   Opacity="0.8"/>
                            <Frame BorderColor="#2A2F37" 
                                   CornerRadius="12" 
                                   Padding="0" 
                                   HasShadow="False"
                                   BackgroundColor="#16191F">
                                <Entry x:Name="PasswordEntry"
                                       Placeholder="Şifrenizi girin"
                                       PlaceholderColor="#6B7280"
                                       TextColor="{StaticResource OnSurface}"
                                       BackgroundColor="Transparent"
                                       IsPassword="True"
                                       Margin="16,12,16,12"
                                       FontSize="14"/>
                            </Frame>
                        </VerticalStackLayout>
                        
                        <!-- Error Message -->
                        <Label x:Name="ErrorLabel"
                               TextColor="#EF4444"
                               FontSize="12"
                               IsVisible="False"
                               Margin="0,8,0,0"
                               Opacity="0.9"/>
                        
                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Text="Giriş Yap"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource OnPrimary}"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                Padding="0,14,0,14"
                                Margin="0,8,0,0"
                                Clicked="OnLoginClicked"
                                BorderWidth="0"/>
                        
                        <!-- Loading Indicator -->
                        <ActivityIndicator x:Name="LoadingIndicator"
                                          IsRunning="False"
                                          IsVisible="False"
                                          Color="{StaticResource Primary}"
                                          Margin="0,12,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Register Link -->
                <StackLayout Orientation="Horizontal" 
                             HorizontalOptions="Center"
                             Spacing="4"
                             Margin="0,0,0,40">
                    <Label Text="Hesabınız yok mu?" 
                           TextColor="{StaticResource OnSurfaceVariant}"
                           FontSize="13"
                           Opacity="0.7"/>
                    <Label Text="Kaydol" 
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
