{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "blinkr_notifications"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "password",
    "Exchange": "blinkr.events",
    "QueueName": "notifications.worker"
  },
  "Fcm": {
    "CredentialsPath": ""
  },
  "Jwt": {
    "Issuer": "Blinkr.Identity",
    "Audience": "blinkr.api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
