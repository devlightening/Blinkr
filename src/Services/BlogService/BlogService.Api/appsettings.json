{
  "ConnectionStrings": {
    "BlogDb": "Host=localhost;Port=5432;Database=blinkr_blog;Username=silvanus",
    "EventStore": "esdb://127.0.0.1:2113?tls=false&tlsVerifyCert=false",
    "MongoDb": "mongodb://localhost:27017",
    "RabbitMq": "amqp://user:password@localhost:5672",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NowFeed": {
    "DecayHalfLifeSec": 5400,
    "LikeWeight": 2,
    "CommentWeight": 3,
    "ViewWeight": 0.5,
    "DistanceDecayAlpha": 2,
    "MaxRadiusKm": 10,
    "MaxSinceMinutes": 1440,
    "DefaultSinceMinutes": 180
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "Blinkr.Identity",
    "Audience": "blinkr.api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 60
  },
  "MongoDbSettings": {
    "DatabaseName": "BlinkrReadModel"
  },
  "EventStore": {
    "EnableSubscription": true
  },
  "RabbitMq": {
    "Host": "localhost",
    "User": "user",
    "Pass": "password"
  },
  "PlaceService": {
    "BaseUrl": "http://localhost:5225"
  },
  "PlaceProximity": {
    "MaxRealtimePlaceDistanceMeters": 200,
    "MaxAcceptedAccuracyMeters": 500
  },
  "Media": {
    "MaxMediaPerPost": 4,
    "MaxImageBytes": 8000000,
    "MaxVideoBytes": 80000000,
    "PresignExpiryMinutes": 10,
    "OrphanCleanupHours": 24,
    "LocalStorageRoot": "artifacts/media",
    "PublicBasePath": "/api/v1/media/public",
    "AllowedImageContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AllowedVideoContentTypes": [
      "video/mp4",
      "video/quicktime"
    ]
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "TimeoutSeconds": 5,
    "CacheTtlHours": 24,
    "Culture": "tr,en",
    "UserAgent": "Blinkr/1.0 (contact: dev@blinkr.local)",
    "MaxConcurrency": 2,
    "MaxRequestsPerMinute": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "RedisKeyPrefix": "rl",
    "Policies": {
      "Nearby": {
        "Capacity": 60,
        "RefillPerSecond": 1
      },
      "PostLocation": {
        "Capacity": 30,
        "RefillPerSecond": 0.5
      },
      "PostCreate": {
        "Capacity": 10,
        "RefillPerSecond": 0.05
      },
      "Comment": {
        "Capacity": 20,
        "RefillPerSecond": 0.2
      },
      "Reaction": {
        "Capacity": 60,
        "RefillPerSecond": 1
      }
    }
  }
}
