{
  "ConnectionStrings": {
    "BlogDb": "Host=localhost;Port=5432;Database=blinkr_blog;Username=silvanus;Password=Aq.199388200",
    "EventStore": "esdb://127.0.0.1:2113?tls=false&tlsVerifyCert=false",
    "MongoDb": "mongodb://localhost:27017",
    "RabbitMq": "amqp://user:password@localhost:5672",
    "Redis": "localhost:6379"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "NowFeed": {
    "DecayHalfLifeSec": 5400,
    "LikeWeight": 2.0,
    "CommentWeight": 3.0,
    "ViewWeight": 0.5,
    "DistanceDecayAlpha": 2.0,
    "MaxRadiusKm": 10.0,
    "MaxSinceMinutes": 1440,
    "DefaultSinceMinutes": 180
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },

  "Jwt": {
    "Issuer": "https://localhost:7297",
    "Audience": "blinkr.api"
  },

  "MongoDbSettings": {
    "DatabaseName": "BlinkrReadModel"
  },

  "EventStore": {
    "EnableSubscription": false
  },

  "RabbitMq": {
    "Host": "localhost",
    "User": "user",
    "Pass": "password"
  },

  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "TimeoutSeconds": 5,
    "CacheTtlHours": 24,
    "Culture": "tr,en",
    "UserAgent": "Blinkr/1.0 (contact: dev@blinkr.local)",
    "MaxConcurrency": 2,
    "MaxRequestsPerMinute": 60
  },

  "RateLimiting": {
    "Enabled": true,
    "RedisKeyPrefix": "rl",
    "Policies": {
      "Nearby": {
        "Capacity": 60,
        "RefillPerSecond": 1.0
      },
      "PostLocation": {
        "Capacity": 30,
        "RefillPerSecond": 0.5
      }
    }
  }
}
