{
  "ConnectionStrings": {
    "BlogDb": "Host=localhost;Port=5432;Database=blinkr_blog;Username=postgres;Password=postgres123"
  },

  "Jwt": {
    "Authority": "https://localhost:7122"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "BlogService.Api"
    }
  }
}
