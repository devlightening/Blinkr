{
  "ConnectionStrings": {
    "BlogDb": "Host=localhost;Port=5432;Database=blinkr_blog;Username=silvanus;Password=Aq.199388200",
    "EventStore": "esdb://127.0.0.1:2113?tls=false&tlsVerifyCert=false",
    "MongoDb": "mongodb://localhost:27017"
  },

  "MongoDbSettings": {
    "DatabaseName": "BlinkrReadModel"
  },

  "RabbitMq": {
    "Host": "localhost",
    "User": "user",
    "Pass": "password"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "BlogService.Api.EventStoreToRabbitMqPublisher": "Debug"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "BlogService.Api": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },

  "Jwt": {
    "Issuer": "Blinkr.Identity",
    "Audience": "blinkr.api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 60
  },
  "PlaceService": {
    "BaseUrl": "http://localhost:5225"
  },
  "PlaceProximity": {
    "MaxRealtimePlaceDistanceMeters": 200,
    "MaxAcceptedAccuracyMeters": 500
  },

  "Media": {
    "MaxMediaPerPost": 4,
    "MaxImageBytes": 8000000,
    "MaxVideoBytes": 80000000,
    "PresignExpiryMinutes": 10,
    "OrphanCleanupHours": 24,
    "LocalStorageRoot": "artifacts/media",
    "PublicBasePath": "/api/v1/media/public",
    "AllowedImageContentTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedVideoContentTypes": [ "video/mp4", "video/quicktime" ]
  }
}
