<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Versiyonlar Directory.Packages.props dosyasından yönetiliyor -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="MongoDB.Bson" />
		<PackageReference Include="MongoDB.Driver" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="MassTransit.RabbitMQ" />
		<PackageReference Include="MassTransit.EntityFrameworkCore" />
		<PackageReference Include="EventStore.Client.Grpc.Streams" />
		<!-- net10.0 BCL has its own System.Linq.AsyncEnumerable; exclude the transitive
		     System.Linq.Async ref assembly (pulled in via EventStore.Client) to avoid CS0433 -->
		<PackageReference Include="System.Linq.Async" ExcludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlogService.Application\BlogService.Application.csproj" />
		<ProjectReference Include="..\BlogService.Domain\BlogService.Domain.csproj" />
		<ProjectReference Include="..\..\..\BuildingBlocks\Shared.Events\Shared.Events.csproj" />
	</ItemGroup>

</Project>
