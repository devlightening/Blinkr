{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "BlinkrPlaces"
  },
  "RabbitMq": {
    "Host": "localhost",
    "User": "user",
    "Pass": "password"
  },
  "Jwt": {
    "Issuer": "Blinkr.Identity",
    "Audience": "blinkr.api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 60
  },
  "PlaceDiscovery": {
    "Enabled": true,
    "Provider": "osm",
    "OverpassUrl": "https://overpass-api.de/api/interpreter",
    "CoverageTtlMinutes": 10080,
    "MaxViewportPlaces": 80,
    "UserAgent": "Blinkr beta place discovery dev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
